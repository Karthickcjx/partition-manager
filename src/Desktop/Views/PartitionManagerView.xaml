<UserControl x:Class="PartitionManager.Desktop.Views.PartitionManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PartitionManager.Desktop.ViewModels"
             xmlns:ctl="clr-namespace:PartitionManager.Desktop.Controls"
             x:Name="Page" Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ExecuteCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding PropertiesCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ResizeCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ContextMenu x:Key="SegmentMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Create" Icon="&#xE710;" InputGestureText="Ctrl+N" Command="{Binding CreateCommand}" />
            <MenuItem Header="Resize/Move" Icon="&#xE740;" InputGestureText="Ctrl+R" Command="{Binding ResizeCommand}" />
            <MenuItem Header="Split" Icon="&#xE8C6;" Command="{Binding SplitCommand}" />
            <MenuItem Header="Merge" Icon="&#xE71B;" Command="{Binding MergeCommand}" />
            <Separator />
            <MenuItem Header="Format" Icon="&#xE75C;" Command="{Binding FormatCommand}" />
            <MenuItem Header="Delete" Icon="&#xE74D;" InputGestureText="Del" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="Change Drive Letter" Icon="&#xE8D2;" Command="{Binding ChangeLetterCommand}" />
            <MenuItem Header="Change Label" Icon="&#xE8EC;" Command="{Binding ChangeLabelCommand}" />
            <MenuItem Header="{Binding HideMenuText}" Icon="&#xED1A;" Command="{Binding ToggleHiddenCommand}" />
            <Separator />
            <MenuItem Header="Initialize Disk" Icon="&#xEDA2;" Command="{Binding InitializeDiskCommand}" />
            <MenuItem Header="Delete All Partitions" Icon="&#xE74D;" Command="{Binding DeleteAllCommand}" />
            <Separator />
            <MenuItem Header="Properties" Icon="&#xE946;" InputGestureText="Alt+Enter" Command="{Binding PropertiesCommand}" />
        </ContextMenu>

        <Style x:Key="SegmentItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ctl:ProportionalPanel.Weight" Value="{Binding Weight}" />
            <Setter Property="Tag" Value="{Binding DataContext, ElementName=Page}" />
            <Setter Property="ContextMenu" Value="{StaticResource SegmentMenu}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseDoubleClick" Handler="Segment_DoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Seg" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="2"
                                    BorderBrush="Transparent" Padding="10,8" Height="80" SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <Rectangle x:Name="Dash" RadiusX="8" RadiusY="8" Stroke="{DynamicResource SegmentUnallocatedBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnallocated}" Value="True">
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Seg" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type vm:SegmentViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="Usage" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding UsedColumn}" />
                        <ColumnDefinition Width="{Binding FreeColumn}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource SegmentTrackBrush}" />
                    <Border x:Name="Fill" CornerRadius="3" Background="{DynamicResource SegmentDataBrush}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <TextBlock x:Name="Lock" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Margin="0,0,4,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SegmentEncryptedBrush}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextSecondary}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding MapCaption}" Style="{StaticResource TextCaption}" />
                <Ellipse x:Name="PendingDot" Grid.RowSpan="3" Width="8" Height="8" Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" ToolTip="Changed by a pending task" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowUsage}" Value="False">
                    <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnallocated}" Value="True">
                    <Setter TargetName="Usage" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="System">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SegmentSystemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Hidden">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SegmentSystemBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Encrypted">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SegmentEncryptedBrush}" />
                    <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="266" />
        </Grid.ColumnDefinitions>

        <!-- Left: disks -->
        <Grid Grid.Column="0" Margin="28,22,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Reload disk information (F5)" AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Refresh" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Partition Management" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource SubCard}" Padding="6" Margin="0,14,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE710;" Content="Create" Command="{Binding CreateCommand}" ToolTip="Create a partition in unallocated space (Ctrl+N)" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE740;" Content="Resize/Move" Command="{Binding ResizeCommand}" ToolTip="Extend, shrink or move the selected partition (Ctrl+R)" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE8C6;" Content="Split" Command="{Binding SplitCommand}" ToolTip="Split the selected partition in two" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE71B;" Content="Merge" Command="{Binding MergeCommand}" ToolTip="Merge an adjacent partition into the selected one" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete the selected partition (Del)" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE75C;" Content="Format" Command="{Binding FormatCommand}" ToolTip="Format the selected partition" />
                    <Button Style="{StaticResource ToolbarButton}" Tag="&#xE8D2;" Content="Drive Letter" Command="{Binding ChangeLetterCommand}" ToolTip="Change the drive letter" />
                    <Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}" Tag="&#xE712;" Content="More" Click="More_Click" ToolTip="More operations" />
                </StackPanel>
            </Border>

            <!-- Banners -->
            <StackPanel Grid.Row="2">
                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding IsSimulatedLayout, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reload real layout" Command="{Binding RefreshCommand}" />
                        <TextBlock Style="{StaticResource Text}" FontSize="13" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                   Text="Showing the result of a simulation. Nothing was written to disk." />
                    </DockPanel>
                </Border>
                <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Style="{StaticResource Text}" FontSize="13" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Text="{Binding LoadError}" />
                </Border>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding DiscoveryWarnings, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Style="{StaticResource Text}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Text="{Binding DiscoveryWarnings}" />
                </Border>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Disk cards -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MaxHeight="370">
                <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14" Margin="0,0,4,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                        <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Model}" Style="{StaticResource TextSecondary}" Margin="10,0,12,0" VerticalAlignment="Center" MaxWidth="320" />
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoftBrush}"
                                                    Visibility="{Binding IsSystemDisk, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="This disk holds the running Windows installation. Destructive operations on its system partitions are blocked.">
                                                <TextBlock Text="System disk" Style="{StaticResource ChipText}" Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoftBrush}"
                                                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Pending changes" Style="{StaticResource ChipText}" Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource DangerSoftBrush}"
                                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Read-only" Style="{StaticResource ChipText}" Foreground="{DynamicResource DangerBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource DangerSoftBrush}"
                                                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Offline" Style="{StaticResource ChipText}" Foreground="{DynamicResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource SegmentTemplate}"
                                             ItemContainerStyle="{StaticResource SegmentItem}" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{Binding Title, StringFormat='Partition layout of {0}'}"
                                             KeyboardNavigation.DirectionalNavigation="Cycle" PreviewMouseWheel="DiskMap_PreviewMouseWheel">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><ctl:ProportionalPanel MinItemWidth="58" Spacing="6" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Text="{Binding SelectionTitle}" Style="{StaticResource TextSubtitle}" Margin="2,12,0,8" />

            <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4,2">
                <DataGrid ItemsSource="{Binding SelectedRows}" AutomationProperties.Name="Partitions of the selected disk">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Tag" Value="{Binding DataContext, ElementName=Page}" />
                            <Setter Property="ContextMenu" Value="{StaticResource SegmentMenu}" />
                            <EventSetter Event="MouseDoubleClick" Handler="Segment_DoubleClick" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Partition" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"
                                                 Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File system" Binding="{Binding FileSystemText}" Width="0.85*" MinWidth="70" />
                        <DataGridTextColumn Header="Capacity" Binding="{Binding SizeText}" Width="*" MinWidth="82" />
                        <DataGridTextColumn Header="Used" Binding="{Binding UsedText}" Width="*" MinWidth="82" />
                        <DataGridTextColumn Header="Free" Binding="{Binding FreeText}" Width="*" MinWidth="82" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="*" MinWidth="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />

        <!-- Right: task list -->
        <DockPanel Grid.Column="2" Margin="18,22,20,20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="Undo last task (Ctrl+Z)" AutomationProperties.Name="Undo" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding ClearTasksCommand}" ToolTip="Clear all tasks" AutomationProperties.Name="Clear tasks" />
                </StackPanel>
                <TextBlock Text="{Binding TaskTitle}" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" Height="42" ToolTip="Run the pending tasks (Ctrl+Enter)"
                        AutomationProperties.Name="Execute">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Foreground="{DynamicResource TextOnAccentBrush}" />
                        <TextBlock Text="Execute" Margin="8,0,0,0" Foreground="{DynamicResource TextOnAccentBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="2,8,0,0" TextAlignment="Center"
                           Text="{Binding ExecutionModeText}" />
            </StackPanel>

            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="40" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No tasks found" Style="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Pick a partition and an operation. Tasks are previewed on the disk map until you execute them."
                               Style="{StaticResource TextCaption}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                <Border Style="{StaticResource SubCard}" Padding="12,10" Margin="0,0,0,8" ToolTip="{Binding WarningText}" ToolTipService.IsEnabled="{Binding IsHighRisk}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE711;"
                                                VerticalAlignment="Top" Margin="4,-4,-6,0" AutomationProperties.Name="Remove task"
                                                Command="{Binding DataContext.RemoveTaskCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                                            </DockPanel>
                                            <Border x:Name="RiskChip" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="18,6,0,0">
                                                <TextBlock x:Name="RiskText" Text="{Binding RiskText}" Style="{StaticResource ChipText}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHighRisk}" Value="True">
                                        <Setter TargetName="RiskChip" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter TargetName="RiskChip" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
