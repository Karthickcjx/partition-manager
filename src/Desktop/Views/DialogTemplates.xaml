<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="clr-namespace:PartitionManager.Desktop.ViewModels.Dialogs"
                    xmlns:conv="clr-namespace:PartitionManager.Desktop.Converters">

    <!-- Templates in a merged dictionary resolve StaticResource only within this dictionary, so declare what they use here. -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="DialogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TargetBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="DialogSlider" TargetType="Slider">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="1024" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Message -->
    <DataTemplate DataType="{x:Type d:MessageDialogViewModel}">
        <DockPanel>
            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Text="{Binding Glyph}"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource DialogText}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Confirm -->
    <DataTemplate DataType="{x:Type d:ConfirmDialogViewModel}">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Text="&#xE9CE;"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource DialogText}" />
            </DockPanel>
            <Border Style="{StaticResource TargetBox}" Margin="0,14,0,0" Visibility="{Binding Details, Converter={StaticResource NotEmptyToVisibility}}">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Details}" AutomationProperties.Name="Operation preview and affected targets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource DialogText}" FontSize="13" Margin="0,3" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Properties -->
    <DataTemplate DataType="{x:Type d:PropertiesDialogViewModel}">
        <StackPanel>
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="0" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Height="Auto" Padding="0" TextWrapping="Wrap" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                    Visibility="{Binding Issues, Converter={StaticResource NotEmptyToVisibility}}">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource DialogText}" FontSize="13" Foreground="{DynamicResource WarningBrush}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Create -->
    <DataTemplate DataType="{x:Type d:CreatePartitionDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource TargetBox}">
                <StackPanel>
                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="Partition size (MB)" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" VerticalAlignment="Center" Width="80" />
                <TextBox Text="{Binding SizeMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" AutomationProperties.Name="Partition size in megabytes" />
            </DockPanel>
            <Slider Style="{StaticResource DialogSlider}" Minimum="1" Maximum="{Binding MaxMiB}" Value="{Binding SizeMiB}" AutomationProperties.Name="Partition size" />
            <TextBlock Text="Space before the partition (MB)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding FrontMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" AutomationProperties.Name="Space before partition in megabytes" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="File system" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}" AutomationProperties.Name="File system" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Drive letter" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter}" AutomationProperties.Name="Drive letter" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Volume label" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Volume label" />
        </StackPanel>
    </DataTemplate>

    <!-- Resize / Move -->
    <DataTemplate DataType="{x:Type d:ResizePartitionDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource TargetBox}">
                <StackPanel>
                    <TextBlock Text="{Binding PartitionText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Grid Height="34" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding FrontColumn}" />
                    <ColumnDefinition Width="{Binding SizeColumn}" />
                    <ColumnDefinition Width="{Binding RearColumn}" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource SegmentUnallocatedBrush}" />
                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Slider Style="{StaticResource DialogSlider}" Minimum="{Binding MinSizeMiB}" Maximum="{Binding MaxSizeMiB}" Value="{Binding SizeMiB}"
                    AutomationProperties.Name="Partition size" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Space of front part (MB)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FrontMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" IsEnabled="{Binding CanMove}" AutomationProperties.Name="Space before partition" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Partition size (MB)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SizeMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" AutomationProperties.Name="Partition size" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Space of rear part (MB)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RearMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" AutomationProperties.Name="Space after partition" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Text="This file system or partition cannot be moved; only its end can change."
                       Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </StackPanel>
    </DataTemplate>

    <!-- Split -->
    <DataTemplate DataType="{x:Type d:SplitPartitionDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource TargetBox}">
                <TextBlock Text="{Binding PartitionText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
            </Border>
            <Grid Height="34" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding FirstColumn}" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="{Binding SecondColumn}" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="6" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="{Binding FirstText}" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource SegmentSystemBrush}">
                    <TextBlock Text="{Binding SecondText}" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Slider Style="{StaticResource DialogSlider}" Minimum="{Binding MinFirstMiB}" Maximum="{Binding MaxFirstMiB}" Value="{Binding FirstMiB}"
                    AutomationProperties.Name="Size of first part" />
            <TextBlock Text="Size of the original partition after splitting (MB)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding FirstMiB, UpdateSourceTrigger=LostFocus, StringFormat=0}" AutomationProperties.Name="Size of first part in megabytes" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="File system of new partition" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}" AutomationProperties.Name="File system" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Drive letter of new partition" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter}" AutomationProperties.Name="Drive letter" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Volume label of new partition" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Volume label" />
        </StackPanel>
    </DataTemplate>

    <!-- Merge -->
    <DataTemplate DataType="{x:Type d:MergePartitionsDialogViewModel}">
        <StackPanel>
            <TextBlock Text="Merge into" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <Border Style="{StaticResource TargetBox}">
                <TextBlock Text="{Binding TargetText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="Partition to merge" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Source}" AutomationProperties.Name="Partition to merge" />
            <TextBlock Text="{Binding FolderNote}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>

    <!-- Format -->
    <DataTemplate DataType="{x:Type d:FormatPartitionDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource TargetBox}" Background="{DynamicResource DangerSoftBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding PartitionText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
                    <TextBlock Text="Formatting erases every file on this partition." Style="{StaticResource DialogText}" FontSize="13"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="File system" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}" AutomationProperties.Name="File system" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cluster size" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Clusters}" SelectedItem="{Binding Cluster}" AutomationProperties.Name="Cluster size" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Volume label" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Volume label" />
            <CheckBox Content="Quick format" IsChecked="{Binding QuickFormat}" Margin="0,14,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Drive letter -->
    <DataTemplate DataType="{x:Type d:ChangeLetterDialogViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6">
                <Run Text="Current drive letter:" /> <Run Text="{Binding CurrentText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="New drive letter" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter}" AutomationProperties.Name="New drive letter" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="Programs that refer to the old letter (shortcuts, installed apps) may stop working." />
        </StackPanel>
    </DataTemplate>

    <!-- Label -->
    <DataTemplate DataType="{x:Type d:ChangeLabelDialogViewModel}">
        <StackPanel>
            <TextBlock Text="Volume label" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}" AutomationProperties.Name="Volume label" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource FieldLabel}" />
        </StackPanel>
    </DataTemplate>

    <!-- Initialize -->
    <DataTemplate DataType="{x:Type d:InitializeDiskDialogViewModel}">
        <StackPanel>
            <Border Style="{StaticResource TargetBox}">
                <TextBlock Text="{Binding DiskText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="Partition table type" Style="{StaticResource FieldLabel}" />
            <RadioButton Content="GPT partition table (GUID partition table)" IsChecked="{Binding IsGpt}" GroupName="Style" />
            <RadioButton Content="MBR partition table (master boot record)" IsChecked="{Binding IsMbr}" GroupName="Style" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                       Text="This disk is larger than 2 TB. MBR can only use the first 2 TB; choose GPT."
                       Visibility="{Binding LargeDisk, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Progress -->
    <DataTemplate DataType="{x:Type d:ProgressDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding OperationText}" Style="{StaticResource DialogText}" FontWeight="SemiBold" />
            <DockPanel Margin="0,14,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0:0}%}" Style="{StaticResource DialogText}" />
                <TextBlock Text="{Binding StepText}" Style="{StaticResource FieldLabel}" Margin="0" />
            </DockPanel>
            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Progress" />
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource FieldLabel}" Margin="0" />
                <TextBlock Text="{Binding Counter}" Style="{StaticResource FieldLabel}" Margin="0" />
            </DockPanel>
            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
                    Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Simulation: no data is being written." Style="{StaticResource DialogText}" FontSize="13" Foreground="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock Text="{Binding CancelNote}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Visibility="{Binding CancelNote, Converter={StaticResource NotEmptyToVisibility}}" />
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0"
                    AutomationProperties.Name="{Binding CancelText}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
