<UserControl x:Class="PartitionManager.Desktop.Views.FeaturePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PartitionManager.Desktop.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="StatusChip" DataType="{x:Type vm:FeatureCard}">
            <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}" Style="{StaticResource ChipText}" Foreground="{DynamicResource WarningBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,34,40,30">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource TextSubtitle}" FontSize="17" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,22" />

            <!-- Hero card -->
            <Border Style="{StaticResource SubCard}" Padding="36,30" DataContext="{Binding Hero}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="112" Height="112" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="52" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="26" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,12" FontSize="15" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusChip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Rest}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FeatureCard}">
                        <Border Style="{StaticResource SubCard}" Padding="22,24" Margin="0,0,16,16" MinHeight="190">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextSubtitle}" HorizontalAlignment="Center" Margin="0,14,0,8" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" />
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusChip}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
